{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "dist",
    "declarationDir": "dist",
    "declaration": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "shared": ["../shared/dist"],
      "shared/*": ["../shared/dist/*"],
      "quiz-generator": ["../quiz-generator/dist"],
      "quiz-generator/*": ["../quiz-generator/dist/*"]
    },
    "composite": true,
    "sourceMap": true,
    "rootDir": "src"
  },
  "references": [
    { "path": "../shared" },
    { "path": "../quiz-generator" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}