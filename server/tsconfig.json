{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./dist",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "shared": ["../shared"],
      "shared/*": ["../shared/*"],
      "quiz-generator": ["../quiz-generator"],
      "quiz-generator/*": ["../quiz-generator/src/*"]
    },
    "composite": true,
    "sourceMap": true,
    "declaration": true
  },
  "references": [
    { "path": "../shared" },
    { "path": "../quiz-generator" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}